{
  "name": "hospital-nps",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web de avaliação e satisfação hospitalar (FHDOD)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "db:check": "npm --prefix backend run db:check",
    "db:migrate": "npm --prefix backend run migrate:up",
    "db:test": "npm --prefix backend run test:db",
    "user:create": "npm --prefix backend run user:create --",
    "auth:test": "npm --prefix backend run test:auth",
    "survey:test": "npm --prefix backend run test:survey"
  },
  "engines": {
    "node": ">=20"
  }
}
