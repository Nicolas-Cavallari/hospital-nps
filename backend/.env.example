# Copie este arquivo para ".env" (cp .env.example .env) e preencha os valores.
# O arquivo ".env" NUNCA deve ser versionado nem compartilhado.

# Ambiente: development | production
NODE_ENV=development

# Porta da API
PORT=3001

# Conexão com o PostgreSQL do Supabase.
# No painel do Supabase: botão "Connect" > string de conexão do tipo "Session pooler"
# (ou conexão direta, porta 5432). Substitua [SENHA] pela senha do banco.
# Exemplo de formato (NÃO é um valor real):
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[SENHA]@aws-0-regiao.pooler.supabase.com:5432/postgres
DATABASE_URL=

# SSL na conexão com o banco (o Supabase exige SSL): true | false
DB_SSL=true

# Opcional: caminho para o certificado CA do Supabase (baixado no painel em
# Database > Settings > SSL). Com ele, o servidor do banco é verificado.
# Sem ele, a conexão é criptografada, mas o servidor não é verificado.
DB_SSL_CA_PATH=
